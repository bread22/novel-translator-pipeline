{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChapterReviewOutput",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ChapterFix": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "category": {
          "default": "context_conflict",
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "default": "major",
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "replacement": {
          "default": "",
          "title": "Replacement",
          "type": "string"
        },
        "operation": {
          "default": "replace",
          "enum": [
            "replace",
            "clear"
          ],
          "title": "Operation",
          "type": "string"
        },
        "auto_apply": {
          "default": false,
          "title": "Auto Apply",
          "type": "boolean"
        },
        "approved_translation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Translation"
        },
        "consensus": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus"
        },
        "reporters": {
          "items": {
            "type": "string"
          },
          "title": "Reporters",
          "type": "array"
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Reason"
        }
      },
      "required": [
        "id"
      ],
      "title": "ChapterFix",
      "type": "object"
    },
    "ContextFinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "category": {
          "default": "context_conflict",
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "default": "major",
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "consensus": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus"
        },
        "reporters": {
          "items": {
            "type": "string"
          },
          "title": "Reporters",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "ContextFinding",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "checked_ids": {
      "items": {
        "type": "string"
      },
      "title": "Checked Ids",
      "type": "array"
    },
    "fixes": {
      "items": {
        "$ref": "#/$defs/ChapterFix"
      },
      "title": "Fixes",
      "type": "array"
    },
    "context_findings": {
      "items": {
        "$ref": "#/$defs/ContextFinding"
      },
      "title": "Context Findings",
      "type": "array"
    },
    "dual_review": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dual Review"
    },
    "review_diagnostics": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Diagnostics"
    }
  }
}
