{
  "$defs": {
    "ChapterFix": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "category": {
          "default": "context_conflict",
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "default": "major",
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "replacement": {
          "default": "",
          "title": "Replacement",
          "type": "string"
        },
        "auto_apply": {
          "default": false,
          "title": "Auto Apply",
          "type": "boolean"
        },
        "approved_translation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Translation"
        },
        "consensus": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus"
        },
        "reporters": {
          "items": {
            "type": "string"
          },
          "title": "Reporters",
          "type": "array"
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Reason"
        }
      },
      "required": [
        "id"
      ],
      "title": "ChapterFix",
      "type": "object"
    },
    "ChapterState": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "important_changes": {
          "items": {
            "type": "string"
          },
          "title": "Important Changes",
          "type": "array"
        },
        "active_entities": {
          "items": {
            "type": "string"
          },
          "title": "Active Entities",
          "type": "array"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "timeline": {
          "items": {
            "type": "string"
          },
          "title": "Timeline",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        }
      },
      "title": "ChapterState",
      "type": "object"
    },
    "DeltaConflict": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "existing_value": {
          "default": "",
          "title": "Existing Value",
          "type": "string"
        },
        "proposed_value": {
          "default": "",
          "title": "Proposed Value",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "reporters": {
          "items": {
            "type": "string"
          },
          "title": "Reporters",
          "type": "array"
        }
      },
      "required": [
        "key"
      ],
      "title": "DeltaConflict",
      "type": "object"
    },
    "GlossaryDelta": {
      "additionalProperties": false,
      "properties": {
        "add": {
          "items": {
            "$ref": "#/$defs/GlossaryEntry"
          },
          "title": "Add",
          "type": "array"
        },
        "update": {
          "items": {
            "$ref": "#/$defs/GlossaryEntry"
          },
          "title": "Update",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/DeltaConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "title": "GlossaryDelta",
      "type": "object"
    },
    "GlossaryEntry": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "category": {
          "default": "other",
          "title": "Category",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "reporters": {
          "items": {
            "type": "string"
          },
          "title": "Reporters",
          "type": "array"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "GlossaryEntry",
      "type": "object"
    },
    "MemoryDelta": {
      "additionalProperties": false,
      "properties": {
        "add": {
          "items": {
            "$ref": "#/$defs/MemoryEntry"
          },
          "title": "Add",
          "type": "array"
        },
        "update": {
          "items": {
            "$ref": "#/$defs/MemoryEntry"
          },
          "title": "Update",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/DeltaConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "title": "MemoryDelta",
      "type": "object"
    },
    "MemoryEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "category": {
          "default": "fact",
          "title": "Category",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "reporters": {
          "items": {
            "type": "string"
          },
          "title": "Reporters",
          "type": "array"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "MemoryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "checked_ids": {
      "items": {
        "type": "string"
      },
      "title": "Checked Ids",
      "type": "array"
    },
    "fixes": {
      "items": {
        "$ref": "#/$defs/ChapterFix"
      },
      "title": "Fixes",
      "type": "array"
    },
    "glossary_delta": {
      "$ref": "#/$defs/GlossaryDelta"
    },
    "memory_delta": {
      "$ref": "#/$defs/MemoryDelta"
    },
    "chapter_state": {
      "$ref": "#/$defs/ChapterState"
    },
    "dual_review": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dual Review"
    }
  },
  "title": "Chapter Review Output v2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
