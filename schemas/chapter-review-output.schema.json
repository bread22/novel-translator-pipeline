{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checked_ids", "issues", "term_updates"],
  "properties": {
    "checked_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "issues", "suggestion", "approved_translation", "auto_apply", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "low", "medium", "high"]},
          "issues": {"type": "array", "items": {"type": "string"}},
          "suggestion": {"type": "string"},
          "approved_translation": {"type": "string"},
          "auto_apply": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "term_updates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source", "target", "category", "note", "confidence"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "category": {"type": "string", "enum": ["name", "place", "organization", "title", "object", "other"]}, "note": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}}
  }
}
