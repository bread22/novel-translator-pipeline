# Path to the cloned Novel Translator tool.
NOVEL_TRANSLATOR_ROOT=/home/bread22/src/novel-translator

# config.toml is authoritative. These optional variables override role/provider fields.
PRIMARY_TRANSLATOR=antigravity
FALLBACK_TRANSLATOR=lmstudio
REVIEWER=opencode
ANTIGRAVITY_BASE_URL=http://127.0.0.1:1235/v1
ANTIGRAVITY_MODEL=gemini-3.7-flash
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=murasaki-14b-v0.2
LMSTUDIO_CONTEXT_TOKENS=8192
OPENCODE_MODEL=opencode/muse-spark-1.2-contributor-free
