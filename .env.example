# Path to the cloned Novel Translator tool.
NOVEL_TRANSLATOR_ROOT=/home/bread22/src/novel-translator

# Codex CLI uses its own login/configuration; no OpenAI key is stored here.
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=low

# Set REVIEWER_BACKEND=opencode to use the local OpenCode CLI for all review modes.
# OPENCODE_MODEL may be provider/model; role-specific values take precedence.
REVIEWER_BACKEND=codex
OPENCODE_MODEL=
OPENCODE_REVIEWER_MODEL=
OPENCODE_TRANSLATOR_MODEL=

# Keep the existing providers by default. Set the primary provider to opencode
# when OpenCode should perform translation too.
TRANSLATION_PRIMARY_PROVIDER=gemini
TRANSLATION_FALLBACK_PROVIDER=murasaki-local
