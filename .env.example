# ==========================================
# Novel Translator Pipeline 环境变量配置
# ==========================================

# 1. novel-translator checkout 路径 (默认使用仓库内 vendor/novel-translator)
# NOVEL_TRANSLATOR_ROOT=/path/to/novel-translator
# Windows 路径示例:
# NOVEL_TRANSLATOR_ROOT=C:/Users/username/src/novel-translator

# 2. 配置文件路径覆盖 (可选，默认读取项目根目录 config.toml)
# TRANSLATOR_CONFIG=config.toml

# 3. 在线 API Key 配置 (按需启用)
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Provider 角色临时覆盖 (可选)
# PRIMARY_TRANSLATOR=antigravity
# FALLBACK_TRANSLATORS=opencode,lmstudio
# REVIEWER=opencode
