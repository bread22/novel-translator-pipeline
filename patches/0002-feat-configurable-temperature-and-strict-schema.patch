- config: setting.toml 增加 temperature (默认0.3) 与 max_tokens (默认4096)
- translator: 翻译请求引入 strict: true 的 json_schema 增强输出稳定性
- 补充对应单元测试
---
 app/config.py         |  4 ++++
 app/translator.py     | 32 ++++++++++++++++++++++++++++-
 setting.example.toml  |  2 ++
 tests/test_book_io.py | 48 +++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/app/config.py b/app/config.py
index 47a6f42..b6201df 100644
--- a/app/config.py
+++ b/app/config.py
@@ -29,6 +29,8 @@ class TranslationConfig:
     style_sample_file: str = ""
     style_sample_max_chars: int = 1200
     batch_max_chars: int = 4000
+    temperature: float = 0.3
+    max_tokens: int = 4096
     retry_count: int = 3
     retry_delay: int = 2
     quality_passes: int = 2
@@ -174,6 +176,8 @@ def load_config(root: Path, config_path: Path | None = None) -> AppConfig:
         style_sample_file=str(translation_raw.get("style_sample_file", "")),
         style_sample_max_chars=int(translation_raw.get("style_sample_max_chars", 1200)),
         batch_max_chars=int(translation_raw.get("batch_max_chars", 4000)),
+        temperature=float(translation_raw.get("temperature", 0.3)),
+        max_tokens=int(translation_raw.get("max_tokens", 4096)),
         retry_count=int(translation_raw.get("retry_count", 3)),
         retry_delay=int(translation_raw.get("retry_delay", 2)),
         quality_passes=int(translation_raw.get("quality_passes", 2)),
diff --git a/app/translator.py b/app/translator.py
index a8a06ce..394984f 100644
--- a/app/translator.py
+++ b/app/translator.py
@@ -11,6 +11,34 @@ from app.placeholders import placeholder_payload_for_paragraph
 from app.terminology import Term, relevant_terms_for_text
 
 
+TRANSLATION_RESPONSE_SCHEMA = {
+    "type": "json_schema",
+    "json_schema": {
+        "name": "translation_result",
+        "strict": True,
+        "schema": {
+            "type": "object",
+            "properties": {
+                "items": {
+                    "type": "array",
+                    "items": {
+                        "type": "object",
+                        "properties": {
+                            "id": {"type": "string"},
+                            "text": {"type": "string"},
+                        },
+                        "required": ["id", "text"],
+                        "additionalProperties": False,
+                    },
+                }
+            },
+            "required": ["items"],
+            "additionalProperties": False,
+        },
+    },
+}
+
+
 def pending_paragraphs(paragraphs: Iterable[Paragraph]) -> list[Paragraph]:
     return [paragraph for paragraph in paragraphs if not paragraph.translated.strip()]
 
@@ -61,7 +89,9 @@ def translate_batch(
                     {"role": "system", "content": system_prompt},
                     {"role": "user", "content": json.dumps(payload, ensure_ascii=False)},
                 ],
-                response_format={"type": "json_object"},
+                temperature=config.translation.temperature,
+                max_tokens=config.translation.max_tokens,
+                response_format=TRANSLATION_RESPONSE_SCHEMA,
             )
             content = response.choices[0].message.content or ""
             result = parse_translation_response(content)
diff --git a/setting.example.toml b/setting.example.toml
index 3fe7582..96bce79 100644
--- a/setting.example.toml
+++ b/setting.example.toml
@@ -13,6 +13,8 @@ dialogue_style = "符合中文网文/出版小说阅读习惯，称谓、语气
 style_sample_file = ""
 style_sample_max_chars = 1200
 batch_max_chars = 4000
+temperature = 0.3
+max_tokens = 4096
 retry_count = 3
 retry_delay = 2
 quality_passes = 2
diff --git a/tests/test_book_io.py b/tests/test_book_io.py
index 0aee617..62120f5 100644
--- a/tests/test_book_io.py
+++ b/tests/test_book_io.py
@@ -1598,3 +1598,51 @@ def _write_epub_with_metadata(path: Path) -> None:
             """<?xml version="1.0"?>
 <html xmlns="http://www.w3.org/1999/xhtml"><body><p>Hello.</p></body></html>""",
         )
+
+
+def test_translation_config_temperature_and_max_tokens_defaults_and_custom(tmp_path: Path) -> None:
+    from app.config import load_config
+
+    setting_file = tmp_path / "setting.toml"
+    setting_file.write_text(
+        """
+[translation]
+batch_max_chars = 4000
+""",
+        encoding="utf-8",
+    )
+    default_config = load_config(tmp_path, setting_file)
+    assert default_config.translation.temperature == 0.3
+    assert default_config.translation.max_tokens == 4096
+
+    custom_setting = tmp_path / "custom_setting.toml"
+    custom_setting.write_text(
+        """
+[translation]
+batch_max_chars = 4000
+temperature = 0.8
+max_tokens = 2048
+""",
+        encoding="utf-8",
+    )
+
+    custom_config = load_config(tmp_path, custom_setting)
+    assert custom_config.translation.temperature == 0.8
+    assert custom_config.translation.max_tokens == 2048
+
+
+def test_translation_response_schema_strict_format() -> None:
+    from app.translator import TRANSLATION_RESPONSE_SCHEMA
+
+    assert TRANSLATION_RESPONSE_SCHEMA["type"] == "json_schema"
+    json_schema = TRANSLATION_RESPONSE_SCHEMA["json_schema"]
+    assert json_schema["strict"] is True
+    assert json_schema["name"] == "translation_result"
+    schema = json_schema["schema"]
+    assert schema["type"] == "object"
+    assert schema["required"] == ["items"]
+    assert schema["additionalProperties"] is False
+    items_schema = schema["properties"]["items"]
+    assert items_schema["type"] == "array"
+    assert items_schema["items"]["required"] == ["id", "text"]
+
