{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translator automation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["paths", "roles", "providers", "pipeline", "queue"],
  "properties": {
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_root", "translation_policy"],
      "properties": {
        "output_root": {"type": "string", "minLength": 1},
        "translation_policy": {"type": "string", "minLength": 1}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": true,
      "required": ["primary_translator", "reviewer"],
      "properties": {
        "primary_translator": {"type": "string", "minLength": 1},
        "fallback_translator": {"type": "string"},
        "secondary_fallback_translator": {"type": "string"},
        "fallback_translators": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "reviewer": {"type": "string", "minLength": 1},
        "secondary_reviewer": {"type": "string"},
        "dual_review": {"type": "boolean"},
        "fallback_reviewers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/httpProvider"},
          {"$ref": "#/$defs/cliProvider"},
          {"$ref": "#/$defs/antigravityProvider"}
        ]
      }
    },
    "knowledge_extractor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "credential_ref": {"type": "string"},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "request_timeout": {"type": "integer", "minimum": 1},
        "input_hard_limit_chars": {"type": "integer", "minimum": 1}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cycles",
        "max_chapter_batches",
        "primary_batch_max_chars",
        "max_provider_split_depth",
        "translation_max_tokens",
        "health_check_timeout",
        "layout"
      ],
      "properties": {
        "max_cycles": {"type": "integer", "minimum": 0},
        "max_chapter_batches": {"type": "integer", "minimum": 1},
        "primary_batch_max_chars": {"type": "integer", "minimum": 1},
        "max_provider_split_depth": {"type": "integer", "minimum": 0},
        "translation_max_tokens": {"type": "integer", "minimum": 1},
        "health_check_timeout": {"type": "integer", "minimum": 1},
        "split_on_content_filter": {"type": "boolean"},
        "review_chunk_min_chars": {"type": "integer", "minimum": 1},
        "review_chunk_max_chars": {"type": "integer", "minimum": 1},
        "review_context_before": {"type": "integer", "minimum": 0},
        "review_context_after": {"type": "integer", "minimum": 0},
        "review_backtrack_enabled": {"type": "boolean"},
        "review_backtrack_min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "transient_http_retries": {"type": "integer", "minimum": 0},
        "transient_backoff_min_seconds": {"type": "number", "minimum": 0},
        "transient_backoff_max_seconds": {"type": "number", "minimum": 0},
        "transient_backoff_multiplier": {"type": "number", "minimum": 1},
        "transient_backoff_cap_seconds": {"type": "number", "minimum": 0},
        "timeout_retries": {"type": "integer", "minimum": 0},
        "connection_retries": {"type": "integer", "minimum": 0},
        "review_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "budget_version": {"type": "string", "minLength": 1},
            "selector_version": {"type": "string", "minLength": 1},
            "operational_input_hard_limit_chars": {"type": "integer", "minimum": 1},
            "background_soft_limit_chars": {"type": "integer", "minimum": 0},
            "operational_headroom_chars": {"type": "integer", "minimum": 0},
            "local_context_soft_chars": {"type": "integer", "minimum": 0},
            "glossary_soft_chars": {"type": "integer", "minimum": 0},
            "memory_soft_chars": {"type": "integer", "minimum": 0},
            "state_soft_chars": {"type": "integer", "minimum": 0},
            "book_summary_soft_chars": {"type": "integer", "minimum": 0},
            "known_hits_soft_chars": {"type": "integer", "minimum": 0},
            "recent_evidence_chapters": {"type": "integer", "minimum": 0},
            "entity_relation_hops": {"type": "integer", "minimum": 0, "maximum": 1},
            "max_global_critical_facts": {"type": "integer", "minimum": 0}
          }
        },
        "review_apply": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["report_only", "hard_fix"]},
            "style_auto_apply": {"const": false},
            "minimum_confidence": {"type": "number", "minimum": 0.9, "maximum": 1.0}
          }
        },
        "layout": {"enum": ["preserve", "horizontal"]}
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_root", "max_cycles", "apply", "autonomous", "finalize", "stop_on_error"],
      "properties": {
        "source_root": {"type": "string", "minLength": 1},
        "max_cycles": {"type": "integer", "minimum": 1},
        "apply": {"type": "boolean"},
        "autonomous": {"type": "boolean"},
        "finalize": {"type": "boolean"},
        "stop_on_error": {"type": "boolean"},
        "layout": {"enum": ["preserve", "horizontal"]}
      }
    }
  },
  "$defs": {
    "httpProvider": {
      "type": "object",
      "required": ["type", "base_url", "model"],
      "additionalProperties": true,
      "properties": {
        "type": {"const": "openai"},
        "base_url": {"type": "string", "pattern": "^https?://"},
        "model": {"type": "string", "minLength": 1},
        "api_key": {"type": "string"},
        "context_tokens": {"type": "integer", "minimum": 1024},
        "timeout": {"type": "integer", "minimum": 1}
      }
    },
    "cliProvider": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "binary", "timeout"],
      "properties": {
        "type": {"enum": ["opencode", "codex"]},
        "binary": {"type": "string", "minLength": 1},
        "model": {"type": "string"},
        "timeout": {"type": "integer", "minimum": 1}
      }
    },
    "antigravityProvider": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "agy", "model", "timeout"],
      "properties": {
        "type": {"const": "antigravity"},
        "agy": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "timeout": {"type": "integer", "minimum": 1},
        "context_tokens": {"type": "integer", "minimum": 1024}
      }
    }
  }
}
