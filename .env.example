# ==========================================
# Novel Translator Pipeline 环境变量配置
# ==========================================

# 1. novel-translator 本地仓库路径 (默认自动优先使用内置 vendor/novel-translator 或 ~/src/novel-translator)
# NOVEL_TRANSLATOR_ROOT=/path/to/novel-translator
# Windows 路径示例:
# NOVEL_TRANSLATOR_ROOT=C:/Users/username/src/novel-translator

# 2. novel-translator 专用的 Python 解释器路径 (可选，默认使用其 .venv 或系统 python3)
# NOVEL_TRANSLATOR_PYTHON=/path/to/novel-translator/.venv/bin/python
# Windows 路径示例:
# NOVEL_TRANSLATOR_PYTHON=C:/Users/username/src/novel-translator/.venv/Scripts/python.exe

# 3. 配置文件路径覆盖 (可选，默认读取项目根目录 config.toml)
# TRANSLATOR_CONFIG=config.toml

# 4. 在线 API Key 配置 (按需启用)
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. Provider 角色临时覆盖 (可选)
# PRIMARY_TRANSLATOR=antigravity
# FALLBACK_TRANSLATORS=opencode,lmstudio
# REVIEWER=opencode
